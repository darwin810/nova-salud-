NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27018/nova_salud?replicaSet=rs0
# Optional if mongod.exe is installed outside C:\Program Files\MongoDB\Server.
MONGOD_PATH=
# Generate a private key: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Leave blank for an automatically generated local development key. Set a strong random value in production.
JWT_SECRET=
# Development-only demo access. In production, create the first administrator securely out of band.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
# Set to the exact public origin in production, for example https://botica.example.com
APP_ORIGIN=http://localhost:3000
